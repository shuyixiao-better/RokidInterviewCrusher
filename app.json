{
  "package": "com.rokid.interview.crusher",
  "name": "吊打面试官",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/assets/icon.png",
  "features": [
    {
      "name": "system.audio"
    },
    {
      "name": "system.speech"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.network"
    },
    {
      "name": "system.prompt"
    }
  ],
  "permissions": [
    {
      "origin": "*"
    }
  ],
  "config": {
    "designWidth": 400,
    "data": {
      "fontSize": 14
    }
  },
  "router": {
    "entry": "pages/HomePage",
    "pages": {
      "pages/HomePage": {
        "component": "index"
      },
      "pages/InterviewPage": {
        "component": "index"
      },
      "pages/ReviewPage": {
        "component": "index"
      },
      "pages/SettingsPage": {
        "component": "index"
      }
    }
  },
  "display": {
    "titleBar": false,
    "menu": false,
    "fullScreen": true
  }
}
